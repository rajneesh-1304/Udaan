# Server Configuration
PORT=3003
APP_NAME=auth-backend
JWT_SECRET=super_secret_jwt_key_change_in_production

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=auth_db

# RabbitMQ Configuration
RABBITMQ_DSN=amqp://guest:guest@localhost:5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HEARTBEAT_INTERVAL=30

# RabbitMQ Queues & Exchanges
RABBITMQ_EVENTS_QUEUE=auth_events_queue
RABBITMQ_EVENTS_QUEUE_BINDING_KEY=auth.*
RABBITMQ_FANOUT_EXCHANGE=auth_fanout_exchange
RABBITMQ_FANOUT_EXCHANGE_TYPE=fanout

RABBITMQ_EVENTS_RETRY_QUEUE=auth_events_retry_queue
RABBITMQ_EVENTS_RETRY_QUEUE_BINDING_KEY=auth.retry
RABBITMQ_DIRECT_EXCHANGE=auth_direct_exchange
RABBITMQ_DIRECT_EXCHANGE_TYPE=direct

RABBITMQ_ERROR_QUEUE_ROUTING_KEY=auth.error

# RabbitMQ Retries & Limits
RABBITMQ_DELAYED_RETRIES=3
RABBITMQ_IMMEDIATE_RETRIES=2
RABBITMQ_RETRY_QUEUE_MESSAGE_TTL=5000
RABBITMQ_CONSUME_MESSAGE_LIMIT=10
RABBITMQ_DISPATCH_MESSAGE_LIMIT=10

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Mail Configuration
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_AUTH=no_auth
MAIL_SENDER_EMAIL=no-reply@udaan.com
MAIL_USERNAME=
MAIL_PASSWORD=
